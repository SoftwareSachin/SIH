modules = ["nodejs-20", "python-3.11", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"
packages = ["cairo", "ffmpeg-full", "freetype", "ghostscript", "glibcLocales", "gobject-introspection", "gtk3", "hdf5", "imagemagick", "jq", "lcms2", "libGL", "libGLU", "libimagequant", "libjpeg", "libjpeg_turbo", "libpng", "libtiff", "libwebp", "libxcrypt", "openjpeg", "pkg-config", "poppler", "poppler-utils", "poppler_utils", "python311", "qhull", "tcl", "tesseract", "tk", "which", "xsimd", "zlib"]

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "start"]
build = ["npm", "run", "build"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 32819
externalPort = 3003

[[ports]]
localPort = 33479
externalPort = 8008

[[ports]]
localPort = 33985
externalPort = 3002

[[ports]]
localPort = 34117
externalPort = 3000

[[ports]]
localPort = 34417
externalPort = 8099

[[ports]]
localPort = 34491
externalPort = 3001

[[ports]]
localPort = 40231
externalPort = 6800

[[ports]]
localPort = 40389
externalPort = 4200

[[ports]]
localPort = 41073
externalPort = 5000

[[ports]]
localPort = 41079
externalPort = 8000

[[ports]]
localPort = 41777
externalPort = 8080

[[ports]]
localPort = 43289
externalPort = 5173

[[ports]]
localPort = 46331
externalPort = 6000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
